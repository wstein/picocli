{
  "$schema": "https://wstein.github.io/picocli/spec/schema/command-spec.schema.json",
  "name": "flix",
  "description": [
    "The Flix Programming Language 0.76.2"
  ],
  "mixinStandardHelpOptions": true,
  "options": [
    {
      "names": [
        "--json"
      ],
      "type": "boolean",
      "description": [
        "enables json output."
      ],
      "arity": "0"
    },
    {
      "names": [
        "--listen"
      ],
      "type": "int",
      "description": [
        "starts the socket server and listens on the given port."
      ],
      "arity": "1"
    }
  ],
  "subcommands": [
    {
      "name": "init",
      "description": [
        "creates a new project in the current directory."
      ]
    },
    {
      "name": "check",
      "description": [
        "checks the current project for errors."
      ],
      "options": [
        {
          "names": [
            "--github-token"
          ],
          "type": "String",
          "description": [
            "API key to use for GitHub dependency resolution."
          ],
          "arity": "1"
        },
        {
          "names": [
            "--no-install"
          ],
          "type": "boolean",
          "description": [
            "disables automatic installation of dependencies."
          ],
          "arity": "0"
        },
        {
          "names": [
            "--threads"
          ],
          "type": "int",
          "description": [
            "number of threads to use for compilation."
          ],
          "arity": "1"
        },
        {
          "names": [
            "--top"
          ],
          "type": "boolean",
          "description": [
            "displays a live view of where the compiler spends its time."
          ],
          "arity": "0"
        },
        {
          "names": [
            "--Xhelp"
          ],
          "type": "boolean",
          "description": [
            "shows the experimental options for this command."
          ],
          "arity": "0",
          "helpSection": "experimental"
        }
      ],
      "positionalParams": [
        {
          "paramLabel": "<files>",
          "type": "Path[]",
          "description": [
            "input Flix source code files."
          ],
          "arity": "0..*"
        }
      ],
      "argGroups": [
        {
          "exclusive": false,
          "multiplicity": "0..1",
          "helpSection": "experimental",
          "heading": "The following options are experimental:%n",
          "options": [
            {
              "names": [
                "--Xbenchmark-code-size"
              ],
              "type": "boolean",
              "description": [
                "[experimental] benchmarks the size of the generated JVM files."
              ],
              "arity": "0"
            },
            {
              "names": [
                "--Xbenchmark-incremental"
              ],
              "type": "boolean",
              "description": [
                "[experimental] benchmarks the performance of each compiler phase in incremental mode."
              ],
              "arity": "0"
            },
            {
              "names": [
                "--Xbenchmark-phases"
              ],
              "type": "boolean",
              "description": [
                "[experimental] benchmarks the performance of each compiler phase."
              ],
              "arity": "0"
            },
            {
              "names": [
                "--Xbenchmark-frontend"
              ],
              "type": "boolean",
              "description": [
                "[experimental] benchmarks the performance of the frontend."
              ],
              "arity": "0"
            },
            {
              "names": [
                "--Xbenchmark-throughput"
              ],
              "type": "boolean",
              "description": [
                "[experimental] benchmarks the performance of the entire compiler."
              ],
              "arity": "0"
            },
            {
              "names": [
                "--Xlib"
              ],
              "type": "String",
              "description": [
                "[experimental] controls the amount of std. lib. to include (nix, min, all)."
              ],
              "arity": "1"
            },
            {
              "names": [
                "--Xno-deprecated"
              ],
              "type": "boolean",
              "description": [
                "[experimental] disables deprecated features."
              ],
              "arity": "0"
            },
            {
              "names": [
                "--Xprint-phases"
              ],
              "type": "boolean",
              "description": [
                "[experimental] writes the ASTs after each phase to './build/asts/'."
              ],
              "arity": "0"
            },
            {
              "names": [
                "--Xverify"
              ],
              "type": "boolean",
              "description": [
                "[experimental] enables internal verifiers of compiler invariants."
              ],
              "arity": "0"
            },
            {
              "names": [
                "--Xsubeffecting"
              ],
              "type": "String",
              "description": [
                "[experimental] enables sub-effecting in select places"
              ],
              "arity": "1"
            },
            {
              "names": [
                "--Xnewmono"
              ],
              "type": "boolean",
              "description": [
                "[experimental] uses the constraint-based monomorphization pipeline instead of the demand-driven one."
              ],
              "arity": "0"
            }
          ]
        }
      ]
    },
